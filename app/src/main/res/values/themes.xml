<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.VOSTIT" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/vostit_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/vostit_secondary</item>
        <item name="colorTertiary">@color/vostit_accent</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorSurfaceVariant">@color/surface_variant_light</item>
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.VOSTIT" parent="Base.Theme.VOSTIT" />

    <!-- Style Premium pour les Cartes (Glassmorphism look-alike) -->
    <style name="PremiumCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#1A000000</item>
        <item name="cardBackgroundColor">@color/surface_light</item>
    </style>

    <!-- Style Premium pour les Boutons -->
    <style name="PremiumButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">20dp</item>
        <item name="android:paddingVertical">16dp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Style Premium pour les Inputs -->
    <style name="PremiumInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">20dp</item>
        <item name="boxCornerRadiusTopEnd">20dp</item>
        <item name="boxCornerRadiusBottomStart">20dp</item>
        <item name="boxCornerRadiusBottomEnd">20dp</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeColor">@color/vostit_primary</item>
        <item name="enforceTextAppearance">true</item>
    </style>

    <!-- Heritage des anciens styles pour eviter les erreurs de compil -->
    <style name="ModernCardView" parent="PremiumCard" />
    <style name="ModernButton" parent="PremiumButton" />
    <style name="ModernTextInputLayout" parent="PremiumInput" />
    <style name="ModernToolbar" parent="Widget.Material3.Toolbar" />
    <style name="ModernDialog" parent="Theme.Material3.Light.Dialog" />
</resources>
